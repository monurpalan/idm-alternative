{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shardload",
  "version": "0.1.1",
  "identifier": "io.github.monurpalan.shardload",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Shardload",
        "width": 1100,
        "height": 680,
        "minWidth": 720,
        "minHeight": 420,
        "dragDropEnabled": false,
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Mahsum Onur Palan",
    "homepage": "https://github.com/monurpalan/idm-alternative",
    "category": "Utility",
    "shortDescription": "Download manager",
    "longDescription": "An open-source download manager that aims to match Internet Download Manager: segmented downloads with work stealing, browser integration, video, torrents, mirrors and Metalink.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzM0ZBQUJCNEE3OUE5MjIKUldRaXFYbEt1Nm8vRTZsRThZU2VVLzJpSXNSN3VIOXpTVzk2M2xLMHJmbWZQais3aWdzWnJnMUkK",
      "endpoints": [
        "https://github.com/monurpalan/idm-alternative/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
